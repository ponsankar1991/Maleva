# Copy this file to .env and fill values before running `docker compose up`.
# Example .env for local development using existing SQL Server and local Redis

# SQL Server connection (example using host.docker.internal for Docker Desktop)
SPRING_DATASOURCE_URL=jdbc:sqlserver://103.215.139.8:1433;databaseName=DemoMaleva;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=Kassamy@123

# Redis (if you want to override compose redis, otherwise compose starts a local redis)
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# JVM options
JVM_OPTS=-Xms256m -Xmx512m

# Wialon GPS integration (token taken from the legacy Common/gpsapilist.cs account)
WIALON_ENABLED=true
WIALON_TOKEN=bcf761fd35a8ddcb42c042d48c8bcb95702666AF9C6669DBEA5935A50FD26A59D7E9C8CE
WIALON_SYNC_ENABLED=true
