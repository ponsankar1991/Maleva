

# Wialon GPS integration (module/gps). Leave WIALON_ENABLED=false to keep it dark.
# The token is a secret - put the real value in .env, never in .env.example or git.
WIALON_ENABLED=false
WIALON_SYNC_ENABLED=false
WIALON_TOKEN=
WIALON_COMPANY_REF_ID=6
# WIALON_SYNC_CRON=0 0 */6 * * *
# WIALON_RESOURCE_ID=24589375
# WIALON_GROUP_OBJECT_ID=24589610
# WIALON_FUEL_TEMPLATE_ID=2
# WIALON_SPEED_TEMPLATE_ID=3
# WIALON_ENGINE_TEMPLATE_NAME=Maleva Group Engine Hours

# AI / LLM providers (integration/llm). Only the providers you set a key for
# show as "Configured" on the AI Settings screen. All are optional.
# Claude (Anthropic) - best accuracy, pay per use. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
# LLM_CLAUDE_MODEL=claude-opus-5
# LLM_CLAUDE_EFFORT=medium
# Free / cheap OpenAI-compatible providers (pick any; leave blank to hide)
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama needs no key: install from ollama.com and run "ollama pull qwen3-vl:4b"
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3-vl:4b
# Which provider is used when the company has not chosen one on the AI Settings screen
# LLM_DEFAULT_PROVIDER=claude
# Providers tried in order when the chosen one fails, comma-separated (e.g. groq,ollama)
# LLM_FALLBACK_PROVIDERS=
