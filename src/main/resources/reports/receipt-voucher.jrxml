<?xml version="1.0" encoding="UTF-8"?>
<!--
  Printed receipt voucher: the Jasper port of the legacy Crystal CRReceipt2.rpt.

  Every coordinate below was measured from a Crystal export (crReport.pdf of
  RC000002284, 595 x 842 pt): the page margins (24 pt left, 13 pt right, 26 pt
  top), the grey plate behind the logo, the customer / TEL / Attn box beside the
  NO - Date - CHEQUE NO box, the single A/C CODE - A/C NAME - DESCRIPTION -
  AMOUNT row, the Payment Details table, and at the foot the amount in words,
  the NB note and the small print on the left with SUB TOTAL / ROUNDING ADJ /
  NET TOTAL on the right. The typeface is Verdana, as Crystal set it (see
  ReportFonts for the DejaVu fallback).

  Everything printed comes from the SNAPSHOT parameter (ReceiptPrintSnapshot)
  and the line data source (ReceiptPrintLine beans). The Crystal formulas
  (Description fallback, amount in words) are computed in
  ReceiptPrintSnapshotLoader, so nothing here does arithmetic.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="receipt-voucher" pageWidth="595" pageHeight="842" columnWidth="558"
              leftMargin="24" rightMargin="13" topMargin="26" bottomMargin="22"
              whenNoDataType="AllSectionsNoDetail">

    <import value="java.time.format.DateTimeFormatter"/>

    <style name="Base" isDefault="true" fontName="Verdana" fontSize="8" isBlankWhenNull="true"/>
    <style name="Label" style="Base" isBold="true"/>
    <style name="Value" style="Base" fontSize="8.5"/>
    <style name="Cell" style="Base" fontSize="8"/>
    <style name="ColHead" style="Base" fontSize="8" isBold="true"/>

    <parameter name="SNAPSHOT" class="my.maleva.api.module.paymentrecept.print.ReceiptPrintSnapshot"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="rowNumber" class="java.lang.Integer"/>
    <field name="docType" class="java.lang.String"/>
    <field name="docNo" class="java.lang.String"/>
    <field name="docDate" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="originalAmount" class="java.math.BigDecimal"/>
    <field name="paidAmount" class="java.math.BigDecimal"/>

    <variable name="DATE_FMT" class="java.time.format.DateTimeFormatter" calculation="System">
        <initialValueExpression><![CDATA[DateTimeFormatter.ofPattern("dd/MM/yyyy")]]></initialValueExpression>
    </variable>
    <variable name="H" class="java.util.List" calculation="System">
        <initialValueExpression><![CDATA[$P{SNAPSHOT}.getHeaderLines() == null ? java.util.List.of() : $P{SNAPSHOT}.getHeaderLines()]]></initialValueExpression>
    </variable>

    <!-- ====================== first-page heading ====================== -->
    <title>
        <band height="276">
            <!-- grey plate + logo -->
            <rectangle>
                <reportElement x="2" y="0" width="116" height="86" backcolor="#F2F2F2" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" isUsingCache="false" onErrorType="Blank">
                <reportElement x="8" y="3" width="104" height="80"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>

            <!-- company lines -->
            <textField>
                <reportElement style="Label" x="133" y="2" width="425" height="22"/>
                <textElement><font size="15"/></textElement>
                <textFieldExpression><![CDATA[$V{H}.size() > 0 ? $V{H}.get(0) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="133" y="30" width="425" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 1 ? $V{H}.get(1) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="133" y="42" width="425" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 2 ? $V{H}.get(2) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="133" y="54" width="425" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 3 ? $V{H}.get(3) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="133" y="66" width="425" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 4 ? $V{H}.get(4) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="133" y="78" width="425" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 5 ? $V{H}.get(5) : ""]]></textFieldExpression>
            </textField>

            <!-- heading -->
            <textField>
                <reportElement style="Label" x="0" y="94" width="558" height="17"/>
                <textElement textAlignment="Center"><font size="12.5"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getHeading()]]></textFieldExpression>
            </textField>

            <!-- customer box -->
            <rectangle><reportElement x="0" y="113" width="320" height="96"/><graphicElement><pen lineWidth="0.75"/></graphicElement></rectangle>
            <staticText><reportElement style="Label" x="6" y="120" width="62" height="12"/><text><![CDATA[Customer :]]></text></staticText>
            <textField textAdjust="CutText">
                <reportElement style="Label" x="75" y="119" width="240" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerName()]]></textFieldExpression>
            </textField>
            <textField textAdjust="CutText">
                <reportElement style="Base" x="6" y="138" width="310" height="38"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerAddress()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Base" x="6" y="176" width="40" height="12"/><text><![CDATA[TEL :]]></text></staticText>
            <textField>
                <reportElement style="Base" x="62" y="176" width="254" height="12"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerPhone()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="6" y="194" width="50" height="12"/><text><![CDATA[Attn :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="62" y="193" width="254" height="13"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAttentionName()]]></textFieldExpression>
            </textField>

            <!-- NO / Date / CHEQUE NO box -->
            <rectangle><reportElement x="320" y="113" width="238" height="96"/><graphicElement><pen lineWidth="0.75"/></graphicElement></rectangle>
            <line><reportElement x="320" y="137" width="238" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="320" y="161" width="238" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="320" y="185" width="238" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="402" y="113" width="1" height="72"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

            <staticText><reportElement style="Label" x="322" y="119" width="76" height="12"/><textElement textAlignment="Right"/><text><![CDATA[NO :]]></text></staticText>
            <textField>
                <reportElement style="Value" x="406" y="119" width="148" height="12"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getReceiptNo()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="322" y="143" width="76" height="12"/><textElement textAlignment="Right"/><text><![CDATA[Date :]]></text></staticText>
            <textField>
                <reportElement style="Value" x="406" y="143" width="148" height="12"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getReceiptDate() == null ? "" : $P{SNAPSHOT}.getReceiptDate().format($V{DATE_FMT})]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="322" y="167" width="76" height="12"/><textElement textAlignment="Right"/><text><![CDATA[CHEQUE NO. :]]></text></staticText>
            <textField>
                <reportElement style="Value" x="406" y="167" width="148" height="12"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getChequeNo()]]></textFieldExpression>
            </textField>

            <!-- A/C CODE / A/C NAME / DESCRIPTION / AMOUNT -->
            <line><reportElement x="0" y="223" width="558" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <staticText><reportElement style="Base" x="2" y="228" width="70" height="12"/><text><![CDATA[A/C CODE]]></text></staticText>
            <staticText><reportElement style="Base" x="74" y="228" width="196" height="12"/><text><![CDATA[A/C NAME]]></text></staticText>
            <staticText><reportElement style="Base" x="273" y="228" width="190" height="12"/><text><![CDATA[DESCRIPTION]]></text></staticText>
            <staticText><reportElement style="Base" x="470" y="228" width="88" height="12"/><textElement textAlignment="Right"/><text><![CDATA[AMOUNT]]></text></staticText>
            <line><reportElement x="0" y="242" width="558" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <textField><reportElement style="Value" x="2" y="251" width="70" height="12"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getAccountCode()]]></textFieldExpression></textField>
            <textField textAdjust="CutText"><reportElement style="Value" x="74" y="251" width="196" height="12"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getAccountName()]]></textFieldExpression></textField>
            <textField textAdjust="CutText"><reportElement style="Value" x="273" y="250" width="197" height="12"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getDescription()]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Value" x="470" y="251" width="84" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getAmount()]]></textFieldExpression></textField>
        </band>
    </title>

    <!-- ====================== continuation pages ====================== -->
    <pageHeader>
        <band height="18">
            <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
            <textField>
                <reportElement style="Label" x="0" y="2" width="400" height="12"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getHeading() + " " + $P{SNAPSHOT}.getReceiptNo() + " (continued)"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="400" y="2" width="120" height="12"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Base" x="523" y="2" width="35" height="12"/>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- ====================== Payment Details table ====================== -->
    <columnHeader>
        <band height="48">
            <staticText>
                <reportElement style="Label" x="19" y="3" width="200" height="14"/>
                <textElement><font size="9"/></textElement>
                <text><![CDATA[Payment Details]]></text>
            </staticText>
            <line><reportElement x="19" y="22" width="509" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <staticText><reportElement style="ColHead" x="19" y="30" width="40" height="12"/><text><![CDATA[Type]]></text></staticText>
            <staticText><reportElement style="ColHead" x="62" y="30" width="82" height="12"/><text><![CDATA[Doc.No.]]></text></staticText>
            <staticText><reportElement style="ColHead" x="146" y="30" width="82" height="12"/><text><![CDATA[Doc.Date]]></text></staticText>
            <staticText><reportElement style="ColHead" x="230" y="30" width="130" height="12"/><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement style="ColHead" x="361" y="30" width="70" height="12"/><textElement textAlignment="Right"/><text><![CDATA[Orig.Amount]]></text></staticText>
            <staticText><reportElement style="ColHead" x="448" y="30" width="80" height="12"/><textElement textAlignment="Right"/><text><![CDATA[Paid Amount]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15" splitType="Prevent">
            <textField><reportElement style="Cell" x="26" y="2" width="34" height="12"/><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
            <textField><reportElement style="Cell" x="62" y="2" width="82" height="12"/><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
            <textField><reportElement style="Cell" x="146" y="2" width="82" height="12"/><textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight"><reportElement style="Cell" x="230" y="2" width="130" height="12"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Cell" x="361" y="2" width="70" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{originalAmount}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Cell" x="448" y="2" width="80" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{paidAmount}]]></textFieldExpression></textField>
        </band>
    </detail>

    <!-- ====================== continued pages ====================== -->
    <pageFooter>
        <band height="14">
            <staticText>
                <reportElement style="Base" x="0" y="2" width="558" height="12"/>
                <textElement textAlignment="Center"><font size="7" isItalic="true"/></textElement>
                <text><![CDATA[Continued on next page]]></text>
            </staticText>
        </band>
    </pageFooter>

    <!-- ====================== amount in words, NB, totals (page bottom, like Crystal) ====================== -->
    <lastPageFooter>
        <band height="128">
            <textField textAdjust="CutText">
                <reportElement style="Base" x="2" y="2" width="554" height="12"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAmountInWords()]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="14" width="558" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <line><reportElement x="359" y="14" width="1" height="113"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <line><reportElement x="0" y="126" width="558" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>

            <!-- left: NB, small print, FOR -->
            <staticText><reportElement style="Label" x="6" y="25" width="60" height="12"/><text><![CDATA[NB :]]></text></staticText>
            <textField textAdjust="CutText">
                <reportElement style="Base" x="6" y="38" width="348" height="12"/>
                <textElement><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getNbNote()]]></textFieldExpression>
            </textField>
            <textField textAdjust="CutText">
                <reportElement style="Label" x="2" y="61" width="190" height="22"/>
                <textElement textAlignment="Center"><font size="7.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getGeneratedNote()]]></textFieldExpression>
            </textField>
            <line><reportElement x="2" y="84" width="190" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <staticText><reportElement style="Base" x="6" y="95" width="60" height="12"/><text><![CDATA[FOR :]]></text></staticText>

            <!-- right: totals box -->
            <staticText><reportElement style="Label" x="366" y="22" width="90" height="12"/><text><![CDATA[SUB TOTAL]]></text></staticText>
            <staticText><reportElement style="Base" x="460" y="22" width="8" height="12"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement style="Value" x="470" y="22" width="82" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getSubTotal()]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="366" y="40" width="90" height="12"/><text><![CDATA[ROUNDING ADJ]]></text></staticText>
            <staticText><reportElement style="Base" x="460" y="40" width="8" height="12"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement style="Value" x="470" y="40" width="82" height="12"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getRoundingAdjustment()]]></textFieldExpression></textField>
            <line><reportElement x="359" y="55" width="199" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <staticText>
                <reportElement style="Label" x="366" y="63" width="90" height="13"/>
                <textElement><font size="9"/></textElement>
                <text><![CDATA[NET TOTAL]]></text>
            </staticText>
            <staticText><reportElement style="Base" x="460" y="64" width="8" height="12"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00">
                <reportElement style="Value" x="470" y="63" width="82" height="13"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getNetTotal()]]></textFieldExpression>
            </textField>
            <line><reportElement x="359" y="78" width="199" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
        </band>
    </lastPageFooter>
</jasperReport>
