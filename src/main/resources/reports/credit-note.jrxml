<?xml version="1.0" encoding="UTF-8"?>
<!--
  Printed credit note: the Jasper port of the legacy Crystal CRCreditNote.rpt.

  Every font, size, position and rule was measured off a credit note the
  legacy app issued (CN000008402, crReport.pdf), not estimated. The page
  points below are Crystal's: page x = 12 + element x; page y = 18 + y in the
  title band, 250 + y in the column header, 652 + y in the last page footer.

    Verdana throughout (fonts/maleva-fonts.xml): 14 bold company name, 8 for
      the letterhead lines, 11 bold heading, 7 bold labels beside 8 values in
      the box, 6 for the line table and the small print, 8 for the totals.
    logo 126 x 90 stretched, as Crystal drew the square picture
    one box (page y 135-246): customer / address / TEL / Attn on the left,
      NO - Date - INVOICE NO - SALES MAN - Page on the right
    the ten-column line table between two rules
    bottom (page y 652-830): Tax Invoice No over a full-width rule, amount in
      words, Notes, the e-Invoice block when the note has been submitted, the
      small print and AUTHORISED SIGNATURE on the left; SUB TOTAL / GST AMOUNT /
      ROUNDING ADJ, a rule, NET TOTAL, a rule on the right.

  Everything printed comes from the SNAPSHOT parameter (CreditNotePrintSnapshot)
  and the line data source (CreditNotePrintLine beans). Nothing here does
  arithmetic: a change to how a value is derived is a Java change with a test,
  not a template edit.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="credit-note" pageWidth="595" pageHeight="842" columnWidth="571"
              leftMargin="12" rightMargin="12" topMargin="18" bottomMargin="8"
              whenNoDataType="AllSectionsNoDetail">

    <import value="java.time.format.DateTimeFormatter"/>

    <style name="Base" isDefault="true" fontName="Verdana" fontSize="8" isBlankWhenNull="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Label" style="Base" isBold="true"/>
    <style name="Label7" style="Base" fontSize="7" isBold="true"/>
    <style name="Body7" style="Base" fontSize="7"/>
    <style name="Fine" style="Base" fontSize="6"/>

    <parameter name="SNAPSHOT" class="my.maleva.api.module.salecreditmaster.print.CreditNotePrintSnapshot"/>
    <parameter name="QR_IMAGE" class="java.io.InputStream"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="productCode" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="uom" class="java.lang.String"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="discountAmount" class="java.math.BigDecimal"/>
    <field name="taxableAmount" class="java.math.BigDecimal"/>
    <field name="taxPercent" class="java.math.BigDecimal"/>
    <field name="taxAmount" class="java.math.BigDecimal"/>
    <field name="netAmount" class="java.math.BigDecimal"/>

    <variable name="DATE_FMT" class="java.time.format.DateTimeFormatter" calculation="System">
        <initialValueExpression><![CDATA[DateTimeFormatter.ofPattern("dd/MM/yyyy")]]></initialValueExpression>
    </variable>
    <variable name="DATETIME_FMT" class="java.time.format.DateTimeFormatter" calculation="System">
        <initialValueExpression><![CDATA[DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm:ss")]]></initialValueExpression>
    </variable>
    <variable name="H" class="java.util.List" calculation="System">
        <initialValueExpression><![CDATA[$P{SNAPSHOT}.getHeaderLines() == null ? java.util.List.of() : $P{SNAPSHOT}.getHeaderLines()]]></initialValueExpression>
    </variable>
    <!-- "Page 1 of 1" as one centred string: evaluated Auto, this page-reset
         copy holds the page's own number while PAGE_NUMBER holds the total. -->
    <variable name="THIS_PAGE" class="java.lang.Integer" resetType="Page">
        <variableExpression><![CDATA[$V{PAGE_NUMBER}]]></variableExpression>
    </variable>

    <!-- ============ letterhead, heading and the customer / document box ============ -->
    <title>
        <band height="232">
            <image scaleImage="FillFrame" isUsingCache="false" onErrorType="Blank">
                <reportElement x="6" y="0" width="126" height="90"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField>
                <reportElement style="Label" x="138" y="4" width="433" height="18"/>
                <textElement><font size="14"/></textElement>
                <textFieldExpression><![CDATA[$V{H}.size() > 0 ? $V{H}.get(0) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="138" y="32" width="433" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 1 ? $V{H}.get(1) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="138" y="44" width="433" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 2 ? $V{H}.get(2) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="138" y="56" width="433" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 3 ? $V{H}.get(3) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="138" y="68" width="433" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 4 ? $V{H}.get(4) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="138" y="80" width="433" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 5 ? $V{H}.get(5) : ""]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="Label" x="0" y="95" width="558" height="15"/>
                <textElement textAlignment="Center"><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getHeading()]]></textFieldExpression>
            </textField>

            <!-- the box (page x 18-570, y 135-246): an outline, a rule before the
                 labels and another before the values, and horizontal rules only
                 in the right-hand half -->
            <rectangle><reportElement x="6" y="117" width="552" height="111"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle>
            <line><reportElement x="324" y="117" width="1" height="111"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="405" y="117" width="1" height="111"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="324" y="139" width="234" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="324" y="161" width="234" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="324" y="184" width="234" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="324" y="209" width="234" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

            <!-- left half: bold 7 labels, the name and Attn bold 8 -->
            <staticText><reportElement style="Label7" x="12" y="122" width="62" height="10"/><text><![CDATA[Customer :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="78" y="122" width="244" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerName()]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="12" y="140" width="310" height="46"/>
                <textElement><paragraph lineSpacing="Proportional" lineSpacingSize="1.57"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerAddress()]]></textFieldExpression>
            </textField>
            <staticText><reportElement x="12" y="188" width="34" height="11"/><text><![CDATA[TEL :]]></text></staticText>
            <textField>
                <reportElement x="48" y="188" width="274" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerPhone()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label7" x="12" y="212" width="34" height="10"/><text><![CDATA[Attn :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="48" y="212" width="274" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAttentionName()]]></textFieldExpression>
            </textField>

            <!-- right half: bold 7 labels ending at page x 414, values centred in 417-570 -->
            <staticText><reportElement style="Label7" x="328" y="125" width="74" height="10"/><textElement textAlignment="Right"/><text><![CDATA[NO :]]></text></staticText>
            <textField>
                <reportElement x="405" y="125" width="153" height="11"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCreditNoteNo()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label7" x="328" y="146" width="74" height="10"/><textElement textAlignment="Right"/><text><![CDATA[Date :]]></text></staticText>
            <textField>
                <reportElement x="405" y="146" width="153" height="11"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCreditNoteDate() == null ? "" : $P{SNAPSHOT}.getCreditNoteDate().format($V{DATE_FMT})]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label7" x="328" y="170" width="74" height="10"/><textElement textAlignment="Right"/><text><![CDATA[INVOICE NO :]]></text></staticText>
            <textField>
                <reportElement x="405" y="170" width="153" height="11"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getInvoiceNo()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label7" x="328" y="194" width="74" height="10"/><textElement textAlignment="Right"/><text><![CDATA[SALES MAN :]]></text></staticText>
            <textField>
                <reportElement x="405" y="194" width="153" height="11"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getSalesMan()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label7" x="328" y="216" width="74" height="10"/><textElement textAlignment="Right"/><text><![CDATA[Page :]]></text></staticText>
            <textField evaluationTime="Auto">
                <reportElement style="Body7" x="405" y="216" width="153" height="10"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Page " + $V{THIS_PAGE} + " of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ====================== continuation pages ====================== -->
    <pageHeader>
        <band height="18">
            <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
            <textField>
                <reportElement style="Label7" x="6" y="4" width="400" height="10"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getHeading() + " " + $P{SNAPSHOT}.getCreditNoteNo() + " (continued)"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Auto">
                <reportElement style="Body7" x="408" y="4" width="150" height="10"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{THIS_PAGE} + " of " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- ============ the ten-column line table (page y 250-280) ============ -->
    <columnHeader>
        <band height="30">
            <line><reportElement x="0" y="6" width="560" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <staticText><reportElement style="Fine" x="6" y="15" width="40" height="8"/><text><![CDATA[CODE]]></text></staticText>
            <staticText><reportElement style="Fine" x="48" y="15" width="110" height="8"/><text><![CDATA[DESCRIPTION]]></text></staticText>
            <staticText><reportElement style="Fine" x="158" y="15" width="28" height="8"/><textElement textAlignment="Right"/><text><![CDATA[QTY]]></text></staticText>
            <staticText><reportElement style="Fine" x="200" y="15" width="34" height="8"/><textElement textAlignment="Right"/><text><![CDATA[UOM]]></text></staticText>
            <staticText><reportElement style="Fine" x="240" y="15" width="48" height="8"/><textElement textAlignment="Right"/><text><![CDATA[U.PRICE]]></text></staticText>
            <staticText><reportElement style="Fine" x="290" y="15" width="46" height="8"/><textElement textAlignment="Right"/><text><![CDATA[DISC.]]></text></staticText>
            <staticText><reportElement style="Fine" x="342" y="15" width="60" height="8"/><textElement textAlignment="Right"/><text><![CDATA[TAXABLE AMT.]]></text></staticText>
            <staticText><reportElement style="Fine" x="404" y="15" width="34" height="8"/><textElement textAlignment="Right"/><text><![CDATA[GST]]></text></staticText>
            <staticText><reportElement style="Fine" x="442" y="15" width="44" height="8"/><textElement textAlignment="Right"/><text><![CDATA[AMT.]]></text></staticText>
            <staticText><reportElement style="Fine" x="490" y="15" width="68" height="8"/><textElement textAlignment="Right"/><text><![CDATA[NET AMT.]]></text></staticText>
            <line><reportElement x="0" y="28" width="566" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
        </band>
    </columnHeader>

    <!-- one line: code and description wrap (CREDIT / NOTE), the rest sit
         centred on the row and follow it down when it grows -->
    <detail>
        <band height="22" splitType="Prevent">
            <textField textAdjust="StretchHeight">
                <reportElement style="Fine" x="6" y="0" width="40" height="22"/>
                <textElement verticalAlignment="Middle"><paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/></textElement>
                <textFieldExpression><![CDATA[$F{productCode}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement style="Fine" x="48" y="0" width="110" height="22"/>
                <textElement verticalAlignment="Middle"><paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/></textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00"><reportElement style="Fine" stretchType="RelativeToTallestObject" x="158" y="0" width="28" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement style="Fine" stretchType="RelativeToTallestObject" x="200" y="0" width="34" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{uom}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Fine" stretchType="RelativeToTallestObject" x="240" y="0" width="48" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Fine" stretchType="RelativeToTallestObject" x="290" y="0" width="46" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{discountAmount}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Fine" stretchType="RelativeToTallestObject" x="342" y="0" width="60" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{taxableAmount}]]></textFieldExpression></textField>
            <!-- Crystal printed the rate and a spaced percent sign: "0  %" -->
            <textField><reportElement style="Fine" stretchType="RelativeToTallestObject" x="404" y="0" width="34" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{taxPercent}.stripTrailingZeros().toPlainString() + "  %"]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Fine" stretchType="RelativeToTallestObject" x="442" y="0" width="44" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{taxAmount}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Fine" stretchType="RelativeToTallestObject" x="490" y="0" width="68" height="22"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{netAmount}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <staticText>
                <reportElement style="Fine" x="0" y="3" width="558" height="9"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Continued on next page]]></text>
            </staticText>
        </band>
    </pageFooter>

    <!-- ============ bottom of the last page (page y 652-834) ============ -->
    <lastPageFooter>
        <band height="182">
            <staticText><reportElement x="6" y="4" width="100" height="11"/><text><![CDATA[Tax Invoice No :]]></text></staticText>
            <textField>
                <reportElement style="Body7" x="108" y="4" width="250" height="10"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getTaxInvoiceNo()]]></textFieldExpression>
            </textField>

            <!-- rules: full width under Tax Invoice No, the totals divider down to
                 the bottom rule, and the two around NET TOTAL -->
            <line><reportElement x="6" y="14" width="563" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="360" y="14" width="1" height="164"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="360" y="74" width="200" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="360" y="98" width="200" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="0" y="178" width="560" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

            <!-- left column -->
            <textField>
                <reportElement x="6" y="22" width="350" height="22"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAmountInWords()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Fine" x="6" y="46" width="60" height="8"/>
                <textElement><font isBold="true" isUnderline="true"/></textElement>
                <text><![CDATA[Notes :]]></text>
            </staticText>
            <textField>
                <reportElement style="Fine" x="6" y="56" width="350" height="20"/>
                <textElement><font isBold="true" isUnderline="true"/><paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getNotes() == null ? "" : String.join("\n", $P{SNAPSHOT}.getNotes())]]></textFieldExpression>
            </textField>

            <!-- e-Invoice block: hidden entirely until the note is with LHDN -->
            <staticText>
                <reportElement style="Label7" mode="Opaque" backcolor="#FFC000" x="6" y="82" width="350" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[    e-Invoice Information]]></text>
            </staticText>
            <staticText><reportElement style="Body7" x="6" y="95" width="104" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[e-Invoice Status]]></text></staticText>
            <staticText><reportElement style="Body7" x="110" y="95" width="8" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[:]]></text></staticText>
            <textField><reportElement style="Body7" x="120" y="95" width="236" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{SNAPSHOT}.getEInvoiceStatus()]]></textFieldExpression></textField>
            <staticText><reportElement style="Body7" x="6" y="106" width="104" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[Unique Identified No]]></text></staticText>
            <staticText><reportElement style="Body7" x="110" y="106" width="8" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[:]]></text></staticText>
            <textField><reportElement style="Body7" x="120" y="106" width="236" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{SNAPSHOT}.getEInvoiceUid()]]></textFieldExpression></textField>
            <staticText><reportElement style="Body7" x="6" y="117" width="104" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[Validated Date]]></text></staticText>
            <staticText><reportElement style="Body7" x="110" y="117" width="8" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[:]]></text></staticText>
            <textField><reportElement style="Body7" x="120" y="117" width="236" height="10"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{SNAPSHOT}.getEInvoiceValidatedAt() == null ? "" : $P{SNAPSHOT}.getEInvoiceValidatedAt().format($V{DATETIME_FMT})]]></textFieldExpression></textField>

            <!-- small print centred over the signature rule (page x 18-210) -->
            <textField>
                <reportElement style="Fine" x="6" y="136" width="192" height="9"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getGeneratedNoteLine1()]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Fine" x="6" y="146" width="192" height="9"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getGeneratedNoteLine2()]]></textFieldExpression>
            </textField>
            <line><reportElement x="6" y="158" width="190" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <staticText><reportElement style="Label7" x="6" y="166" width="192" height="10"/><textElement textAlignment="Center"/><text><![CDATA[AUTHORISED SIGNATURE]]></text></staticText>

            <!-- right column: bold 8 labels, regular 8 amounts -->
            <staticText><reportElement style="Label" x="366" y="22" width="90" height="11"/><text><![CDATA[SUB TOTAL]]></text></staticText>
            <staticText><reportElement style="Body7" x="462" y="22" width="8" height="10"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="488" y="22" width="69" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getSubtotal()]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="366" y="40" width="90" height="11"/><text><![CDATA[GST AMOUNT]]></text></staticText>
            <staticText><reportElement style="Body7" x="462" y="40" width="8" height="10"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="488" y="40" width="69" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getGstAmount()]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="366" y="58" width="90" height="11"/><text><![CDATA[ROUNDING ADJ]]></text></staticText>
            <staticText><reportElement style="Body7" x="462" y="58" width="8" height="10"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="488" y="58" width="69" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getRoundingAdjustment()]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="366" y="82" width="90" height="11"/><text><![CDATA[NET TOTAL]]></text></staticText>
            <staticText><reportElement style="Body7" x="462" y="82" width="8" height="10"/><text><![CDATA[:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement x="488" y="82" width="69" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getNetTotal()]]></textFieldExpression></textField>

            <!-- LHDN validation QR, in the space Crystal leaves under NET TOTAL -->
            <image scaleImage="RetainShape" hAlign="Center" isUsingCache="false" onErrorType="Blank">
                <reportElement x="425" y="104" width="70" height="70">
                    <printWhenExpression><![CDATA[$P{QR_IMAGE} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{QR_IMAGE}]]></imageExpression>
            </image>
        </band>
    </lastPageFooter>
</jasperReport>
