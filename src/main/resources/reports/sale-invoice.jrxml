<?xml version="1.0" encoding="UTF-8"?>
<!--
  Printed sale invoice: the Jasper port of the legacy Crystal CRInvoice.rpt.

  Every font, size and position here was measured off a Crystal PDF the
  business actually issued (INV000044235), not estimated: Verdana 14 bold for
  the company name, 8 for the address block, 11 bold for the heading, 7 for
  the body with bold labels beside regular values, 8 bold for the totals, 6
  for the small print. The coordinates are the same page points Crystal used,
  so the two pages line up when held against each other.

  Nothing here computes anything. The Crystal formula fields (CN, BLAWB,
  Land, off, PName, subTotalAmount, Amountinwords) are evaluated in
  InvoicePrintSnapshotLoader and AmountInWords, each with tests, and this
  template only prints what it is handed.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sale-invoice" pageWidth="595" pageHeight="842" columnWidth="547"
              leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="12"
              whenNoDataType="AllSectionsNoDetail">

    <import value="java.time.format.DateTimeFormatter"/>

    <!-- Crystal's fonts. Base = Verdana 7 regular, the body size of the page. -->
    <style name="Base" isDefault="true" fontName="Verdana" fontSize="7" isBlankWhenNull="true" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Label" style="Base" isBold="true"/>
    <style name="Body8" style="Base" fontSize="8"/>
    <style name="Total" style="Base" fontSize="8" isBold="true"/>
    <style name="Fine" style="Base" fontSize="6"/>

    <parameter name="SNAPSHOT" class="my.maleva.api.module.invoice.print.InvoicePrintSnapshot"/>
    <parameter name="QR_IMAGE" class="java.io.InputStream"/>
    <parameter name="LOGO" class="java.io.InputStream"/>

    <field name="rowNumber" class="java.lang.Integer"/>
    <field name="productCode" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="uom" class="java.lang.String"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="discountPercent" class="java.math.BigDecimal"/>
    <field name="taxCode" class="java.lang.String"/>
    <field name="taxPercent" class="java.math.BigDecimal"/>
    <field name="taxAmount" class="java.math.BigDecimal"/>
    <field name="lineSubtotal" class="java.math.BigDecimal"/>
    <field name="amount" class="java.math.BigDecimal"/>

    <variable name="DATE_FMT" class="java.time.format.DateTimeFormatter" calculation="System">
        <initialValueExpression><![CDATA[DateTimeFormatter.ofPattern("dd/MM/yyyy")]]></initialValueExpression>
    </variable>
    <variable name="DATETIME_FMT" class="java.time.format.DateTimeFormatter" calculation="System">
        <initialValueExpression><![CDATA[DateTimeFormatter.ofPattern("d/M/yyyy h:mm:ss a", java.util.Locale.ENGLISH)]]></initialValueExpression>
    </variable>
    <variable name="H" class="java.util.List" calculation="System">
        <initialValueExpression><![CDATA[$P{SNAPSHOT}.getHeaderLines() == null ? java.util.List.of() : $P{SNAPSHOT}.getHeaderLines()]]></initialValueExpression>
    </variable>

    <!-- ====================== first-page heading (page y 24-405) ====================== -->
    <title>
        <band height="381">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Top" isUsingCache="false" onErrorType="Blank">
                <reportElement x="0" y="2" width="118" height="86"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>

            <!-- company block: LINE1 bold 14, LINE2-6 regular 8 on a 12pt rhythm -->
            <textField>
                <reportElement style="Label" x="132" y="4" width="415" height="20"/>
                <textElement><font size="14"/></textElement>
                <textFieldExpression><![CDATA[$V{H}.size() > 0 ? $V{H}.get(0) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Body8" x="132" y="32" width="415" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 1 ? $V{H}.get(1) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Body8" x="132" y="44" width="415" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 2 ? $V{H}.get(2) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Body8" x="132" y="56" width="415" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 3 ? $V{H}.get(3) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Body8" x="132" y="68" width="415" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 4 ? $V{H}.get(4) : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Body8" x="132" y="80" width="415" height="12"/>
                <textFieldExpression><![CDATA[$V{H}.size() > 5 ? $V{H}.get(5) : ""]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="Label" x="0" y="96" width="547" height="16"/>
                <textElement textAlignment="Center"><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getHeading()]]></textFieldExpression>
            </textField>

            <!-- customer box (page y 141-253) -->
            <rectangle><reportElement x="0" y="117" width="315" height="112"/><graphicElement><pen lineWidth="0.75"/></graphicElement></rectangle>
            <staticText><reportElement style="Label" x="6" y="122" width="90" height="11"/><text><![CDATA[Customer :]]></text></staticText>
            <textField>
                <reportElement x="102" y="122" width="210" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerLine()]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="false">
                <reportElement x="102" y="146" width="210" height="60"/>
                <textElement><paragraph lineSpacing="Proportional" lineSpacingSize="1.28"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getCustomerAddress()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="6" y="212" width="90" height="11"/><text><![CDATA[Attn :]]></text></staticText>
            <textField>
                <reportElement x="102" y="212" width="126" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAttentionName()]]></textFieldExpression>
            </textField>
            <staticText><reportElement x="234" y="212" width="6" height="11"/><text><![CDATA[/]]></text></staticText>
            <textField>
                <reportElement style="Body8" x="240" y="211" width="72" height="12"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAttentionPhone()]]></textFieldExpression>
            </textField>

            <!-- NO / Date / JOB NO / TERMS / Page box (page x 339-570) -->
            <rectangle><reportElement x="315" y="117" width="231" height="112"/><graphicElement><pen lineWidth="0.75"/></graphicElement></rectangle>
            <line><reportElement x="315" y="142" width="231" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="315" y="165" width="231" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="315" y="189" width="231" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="315" y="212" width="231" height="1"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
            <line><reportElement x="402" y="117" width="1" height="112"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>

            <staticText><reportElement style="Label" x="320" y="125" width="76" height="11"/><textElement textAlignment="Right"/><text><![CDATA[NO :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="408" y="125" width="136" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getInvoiceNo()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="320" y="146" width="76" height="11"/><textElement textAlignment="Right"/><text><![CDATA[Date :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="408" y="146" width="136" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getInvoiceDate() == null ? "" : $P{SNAPSHOT}.getInvoiceDate().format($V{DATE_FMT})]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="320" y="170" width="76" height="11"/><textElement textAlignment="Right"/><text><![CDATA[JOB NO :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="408" y="170" width="136" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getJobNo()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="320" y="194" width="76" height="11"/><textElement textAlignment="Right"/><text><![CDATA[TERMS :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="408" y="194" width="136" height="11"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getPaymentTerms()]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Label" x="320" y="216" width="76" height="11"/><textElement textAlignment="Right"/><text><![CDATA[Page :]]></text></staticText>
            <textField>
                <reportElement style="Label" x="408" y="216" width="38" height="11"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="448" y="216" width="96" height="11"/>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>

            <!-- shipment box (page y 253-405), divider at page x 288 -->
            <rectangle><reportElement x="0" y="229" width="546" height="152"/><graphicElement><pen lineWidth="0.75"/></graphicElement></rectangle>
            <line><reportElement x="264" y="229" width="1" height="152"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>

            <staticText><reportElement style="Label" x="6" y="236" width="90" height="11"/><text><![CDATA[Origin]]></text></staticText>
            <staticText><reportElement x="102" y="236" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="236" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getOrigin()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="6" y="254" width="90" height="11"/><text><![CDATA[Destination]]></text></staticText>
            <staticText><reportElement x="102" y="254" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="254" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getDestination()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="6" y="272" width="90" height="11"/><text><![CDATA[Packages]]></text></staticText>
            <staticText><reportElement x="102" y="272" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="272" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getPackages()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="6" y="302" width="90" height="11"/><text><![CDATA[Vessel offland]]></text></staticText>
            <staticText><reportElement x="102" y="302" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="302" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getVesselOffland()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="6" y="326" width="90" height="11"/><text><![CDATA[Vessel onboard]]></text></staticText>
            <staticText><reportElement x="102" y="326" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="326" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getVesselOnboard()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="6" y="338" width="90" height="11"/><text><![CDATA[Reference]]></text></staticText>
            <staticText><reportElement x="102" y="338" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="338" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getReference()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="6" y="356" width="90" height="11"/><text><![CDATA[Truck Name]]></text></staticText>
            <staticText><reportElement x="102" y="356" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="114" y="356" width="144" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getTruckName()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="236" width="78" height="11"/><text><![CDATA[Weight]]></text></staticText>
            <staticText><reportElement x="348" y="236" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="236" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getWeight()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="266" width="78" height="11"/><text><![CDATA[Do . No]]></text></staticText>
            <staticText><reportElement x="348" y="266" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="266" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getDoNo()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="284" width="78" height="11"/><text><![CDATA[Commodity]]></text></staticText>
            <staticText><reportElement x="348" y="284" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="284" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getCommodity()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="302" width="78" height="11"/><text><![CDATA[Collection Date]]></text></staticText>
            <staticText><reportElement x="348" y="302" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="302" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getCollectionDate() == null ? "" : $P{SNAPSHOT}.getCollectionDate().format($V{DATE_FMT})]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="320" width="78" height="11"/><text><![CDATA[Delivery Date]]></text></staticText>
            <staticText><reportElement x="348" y="320" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="320" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getDeliveryDate() == null ? "" : $P{SNAPSHOT}.getDeliveryDate().format($V{DATE_FMT})]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="338" width="78" height="11"/><text><![CDATA[Truck Size]]></text></staticText>
            <staticText><reportElement x="348" y="338" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="338" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getTruckSize()]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="270" y="356" width="78" height="11"/><text><![CDATA[BL/AWB]]></text></staticText>
            <staticText><reportElement x="348" y="356" width="6" height="11"/><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="360" y="356" width="180" height="11"/><textFieldExpression><![CDATA[$P{SNAPSHOT}.getBlAwb()]]></textFieldExpression></textField>
        </band>
    </title>

    <!-- ====================== continuation pages ====================== -->
    <pageHeader>
        <band height="18">
            <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
            <textField>
                <reportElement style="Label" x="0" y="3" width="400" height="12"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getHeading() + " " + $P{SNAPSHOT}.getInvoiceNo() + " (continued)"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="440" y="3" width="42" height="12"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="484" y="3" width="63" height="12"/>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- ====================== line table (rules at page y 434 and 452) ====================== -->
    <columnHeader>
        <band height="52">
            <line><reportElement x="0" y="29" width="547" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <line><reportElement x="0" y="47" width="547" height="1"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
            <staticText><reportElement x="0" y="34" width="26" height="11"/><text><![CDATA[#]]></text></staticText>
            <staticText><reportElement x="30" y="34" width="46" height="11"/><text><![CDATA[CODE]]></text></staticText>
            <staticText><reportElement x="78" y="34" width="140" height="11"/><text><![CDATA[DESCRIPTION]]></text></staticText>
            <staticText><reportElement x="206" y="34" width="32" height="11"/><textElement textAlignment="Right"/><text><![CDATA[QTY]]></text></staticText>
            <staticText><reportElement x="252" y="34" width="44" height="11"/><text><![CDATA[UOM]]></text></staticText>
            <staticText><reportElement x="298" y="34" width="52" height="11"/><textElement textAlignment="Right"/><text><![CDATA[U.PRICE]]></text></staticText>
            <staticText><reportElement x="352" y="34" width="26" height="11"/><textElement textAlignment="Right"/><text><![CDATA[DISC]]></text></staticText>
            <staticText><reportElement x="390" y="34" width="30" height="11"/><text><![CDATA[TCode]]></text></staticText>
            <staticText><reportElement x="420" y="34" width="24" height="11"/><textElement textAlignment="Right"/><text><![CDATA[ST]]></text></staticText>
            <staticText><reportElement x="446" y="34" width="46" height="11"/><textElement textAlignment="Right"/><text><![CDATA[AMT]]></text></staticText>
            <staticText><reportElement x="494" y="34" width="53" height="11"/><textElement textAlignment="Right"/><text><![CDATA[NET AMOUNT]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="17" splitType="Prevent">
            <textField><reportElement x="0" y="3" width="26" height="11"/><textFieldExpression><![CDATA[$F{rowNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="30" y="3" width="46" height="11"/><textFieldExpression><![CDATA[$F{productCode}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="78" y="3" width="140" height="11"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="206" y="3" width="32" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression></textField>
            <textField><reportElement x="252" y="3" width="44" height="11"/><textFieldExpression><![CDATA[$F{uom}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="298" y="3" width="52" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="352" y="3" width="26" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{discountPercent}]]></textFieldExpression></textField>
            <textField><reportElement x="390" y="3" width="30" height="11"/><textFieldExpression><![CDATA[$F{taxCode}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="420" y="3" width="24" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{taxPercent}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="446" y="3" width="46" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{taxAmount}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="494" y="3" width="53" height="11"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <staticText>
                <reportElement style="Fine" x="0" y="2" width="547" height="10"/>
                <textElement textAlignment="Center"><font isItalic="true"/></textElement>
                <text><![CDATA[Continued on next page]]></text>
            </staticText>
        </band>
    </pageFooter>

    <!-- ====================== totals, notes, e-invoice, signatures (page y 620-830) ====================== -->
    <lastPageFooter>
        <band height="210">
            <textField>
                <reportElement style="Body8" x="0" y="3" width="350" height="12"/>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getAmountInWords()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="0" y="27" width="60" height="11"/>
                <textElement><font isUnderline="true"/></textElement>
                <text><![CDATA[Notes :]]></text>
            </staticText>
            <textField isStretchWithOverflow="false">
                <reportElement x="0" y="44" width="270" height="86"/>
                <textElement><paragraph lineSpacing="Proportional" lineSpacingSize="1.05"/></textElement>
                <textFieldExpression><![CDATA[$P{SNAPSHOT}.getNotes() == null ? "" : String.join("\n\n", $P{SNAPSHOT}.getNotes())]]></textFieldExpression>
            </textField>

            <!-- e-Invoice block: Crystal suppressed it when EInvoiceUid = '' -->
            <staticText>
                <reportElement style="Label" mode="Opaque" backcolor="#FFC000" x="0" y="134" width="292" height="12">
                    <printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[     e-Invoice Information]]></text>
            </staticText>
            <staticText><reportElement x="0" y="147" width="110" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[e-Invoice Status]]></text></staticText>
            <staticText><reportElement x="114" y="147" width="6" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="126" y="147" width="214" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{SNAPSHOT}.getEInvoiceStatus()]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="162" width="110" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[Unique Identified No]]></text></staticText>
            <staticText><reportElement x="114" y="162" width="6" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[:]]></text></staticText>
            <textField><reportElement x="126" y="162" width="214" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{SNAPSHOT}.getEInvoiceUid()]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="177" width="110" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[Validated Date]]></text></staticText>
            <staticText><reportElement x="114" y="177" width="6" height="11"><printWhenExpression><![CDATA[$P{SNAPSHOT}.isEInvoiced()]]></printWhenExpression></reportElement><text><![CDATA[:]]></text></staticText>
