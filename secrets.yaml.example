# Copy this file to secrets.yaml (same folder as pom.xml) and fill in the
# real values. secrets.yaml is git-ignored and must never be committed.
#
# This exists so credentials do not have to be set as environment variables on
# every machine, and do not get hard-coded into source the way the old .NET
# EInvoiceapilist.cs did — those values are in the repository's history for
# good and had to be treated as compromised.
#
# Anything set here can still be overridden by a real environment variable,
# which is how the production server should supply them.

myinvois:
  # LHDN e-invoicing. LIVE everywhere, by decision on 2026-09-09 — the same
  # way the .NET screens have always worked.
  #
  # Be aware of what that means before you push an e-invoice from a test
  # machine: a live submission is a real tax document with a real UUID, and it
  # can only be cancelled (within 72 hours), never deleted. There is no such
  # thing as a throw-away invoice against this environment.
  #
  # Put "preprod" here, with the preprod client id/secret, on any machine that
  # should aim at LHDN's sandbox instead.
  environment: live             # live | preprod
  client-id: ""
  client-secret: ""

# Wialon GPS. This token is the whole credential for the account — anyone
# holding it can read the fleet's positions and history.
wialon:
  token: ""

# LLM providers. Only fill in the ones you actually use.
llm:
  providers:
    gemini:
      api-key: ""
#   claude:
#     api-key: ""

# Mail, if this machine sends invoice or receipt mail.
# mail:
#   smtp-host: ""
#   smtp-username: ""
#   smtp-password: ""
