              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payment",
                "select-supplier-due"
              ],
              "query": [
                {
                  "key": "companyId",
                  "value": "1"
                },
                {
                  "key": "paymentTermId",
                  "value": "1"
                }
              ]
            },
            "description": "Get payment terms days (TDays) for a supplier\n\nReturns the number of days the supplier has to pay (e.g., 30 days, 15 days)"
