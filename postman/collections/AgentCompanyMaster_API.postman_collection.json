{
  "info": {
    "name": "AgentCompanyMaster API",
    "description": "REST API for managing Agent Company Master data with SP_AgentCompany integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Agent Companies - CRUD",
      "item": [
        {
          "name": "1. List All Agent Companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agent-companies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies"
              ]
            },
            "description": "Retrieve all active agent companies (Active != 2)"
          },
          "response": []
        },
        {
          "name": "2. Get Agent Company by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agent-companies/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies",
                "1"
              ]
            },
            "description": "Get a specific agent company by its ID"
          },
          "response": []
        },
        {
          "name": "3. Get by Company Reference ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agent-companies/company/5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies",
                "company",
                "5"
              ]
            },
            "description": "Get all agent companies for a specific company reference ID"
          },
          "response": []
        },
        {
          "name": "4. Create Agent Company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyRefId\": 5,\n  \"name\": \"New Agent Company\",\n  \"dFlag\": 0,\n  \"active\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agent-companies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies"
              ]
            },
            "description": "Create a new agent company"
          },
          "response": []
        },
        {
          "name": "5. Update Agent Company",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyRefId\": 5,\n  \"name\": \"Updated Company Name\",\n  \"dFlag\": 0,\n  \"active\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agent-companies/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies",
                "1"
              ]
            },
            "description": "Update an existing agent company"
          },
          "response": []
        },
        {
          "name": "6. Delete Agent Company",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agent-companies/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies",
                "1"
              ]
            },
            "description": "Delete (soft delete) an agent company"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Agent Companies - Special Operations",
      "item": [
        {
          "name": "7. Bulk Upsert (SP_AgentCompany Logic)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"name\": \"Agent Company 1\",\n    \"dFlag\": 0,\n    \"active\": 1\n  },\n  {\n    \"name\": \"Agent Company 2\",\n    \"dFlag\": 0,\n    \"active\": 1\n  }\n]"
            },
            "url": {
              "raw": "{{base_url}}/api/agent-companies/upsert?companyRefId=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies",
                "upsert"
              ],
              "query": [
                {
                  "key": "companyRefId",
                  "value": "5"
                }
              ]
            },
            "description": "Bulk upsert agent companies (implements SP_AgentCompany logic)\n\nFor each record:\n- If exists with CompanyRefId + Name + Active=1: UPDATE\n- Otherwise: INSERT"
          },
          "response": []
        },
        {
          "name": "8. Search Agent Companies",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/agent-companies/search?companyRefId=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "agent-companies",
                "search"
              ],
              "query": [
                {
                  "key": "companyRefId",
                  "value": "5"
                }
              ]
            },
            "description": "Search agent companies by company reference ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Setup - Variables",
      "item": [
        {
          "name": "Set Base URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Set base_url environment variable",
                  "pm.environment.set(\"base_url\", \"http://localhost:8082\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8082/api/agent-companies",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082",
              "path": [
                "api",
                "agent-companies"
              ]
            }
          }
        },
        {
          "name": "Set JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Update the jwt_token variable with your actual JWT token",
                  "// Example: pm.environment.set(\"jwt_token\", \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\");",
                  "console.log(\"Update jwt_token in Postman environment before running requests\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8082",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8082"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "YOUR_JWT_TOKEN_HERE",
      "type": "string"
    }
  ]
}

